    "edition": {
      "type": "Number",
      "config": {
        "label": "Edition",
        "placeholder": "100"
      }
    },
    "arist_proof_qty": {
      "type": "Number",
      "config": {
        "label": "Aritst Proofs (AP)"
      }
    },
    "medium": {
      "type": "StructuredText",
      "config": {
        "multi": "paragraph,hyperlink",
        "allowTargetBlank": true,
        "label": "Medium Details"
      }
    },
    "page_layout": {
      "type": "Select",
      "config": {
        "options": [
          "panel",
          "generative",
          "token-unit-sale"
        ],
        "label": "Page Layout"
      }
    },
    "grid": {
      "type": "Select",
      "config": {
        "options": [
          "5 cols",
          "4 cols",
          "3 cols",
          "2 cols"
        ],
        "label": "(Tokens Grid)"
      }
    },
    "tokens_endpoint": {
      "type": "Text",
      "config": {
        "label": "(Tokens Endpoint)",
        "placeholder": "https://virus.folia.app/api/tokens"
      }
    },
    "teaser_video": {
      "type": "Link",
      "config": {
        "label": "Teaser Video"
      }
    },
    "teaser_image": {
      "type": "Link",
      "config": {
        "label": "Teaser Image"
      }
    },
    "description": {
      "type": "StructuredText",
      "config": {
        "multi": "paragraph,preformatted,heading1,heading2,heading3,heading4,heading5,heading6,strong,em,hyperlink,image,embed,list-item,o-list-item,rtl",
        "allowTargetBlank": true,
        "label": "Description"
      }
    },
    "details": {
      "type": "StructuredText",
      "config": {
        "multi": "paragraph,hyperlink",
        "allowTargetBlank": true,
        "label": "Details"
      }
    }
  },
  "Meta": {
    "meta_description": {
      "type": "Text",
      "config": {
        "label": "Meta Description"
      }
    },
    "meta_image": {
      "type": "Image",
      "config": {
        "constraint": {
          "width": 1200
        },
        "thumbnails": [],
