          "token": {
            "type": "Slice",
            "fieldset": "Token",
            "description": "–",
            "icon": "art_track",
            "display": "list",
            "non-repeat": {
              "token_id": {
                "type": "Text",
                "config": {
                  "label": "Token ID",
                  "placeholder": "3000001"
                }
              },
              "release_link1": {
                "type": "Link",
                "config": {
                  "select": "document",
                  "customtypes": [
                    "release"
                  ],
                  "label": "Release"
                }
              },
              "lock_label": {
                "type": "Text",
                "config": {
                  "label": "Lock + Label as:",
                  "placeholder": "TBA"
                }
              }
            },
            "repeat": {}
          }
        }
      }
    }
