{
  "Main": {
    "title": {
      "type": "Text",
      "config": {
        "label": "Title"
      }
    },
    "artist": {
      "type": "Text",
      "config": {
        "label": "Artist"
      }
    },
    "uid": {
      "type": "UID",
      "config": {
        "label": "Work ID",
        "placeholder": "2000000"
      }
    },
    "release_link": {
      "type": "Link",
      "config": {
        "select": "document",
        "customtypes": [
          "release"
        ],
        "label": "Release",
        "placeholder": "Select a Release"
      }
    },
    "status": {
      "type": "Select",
      "config": {
        "options": [
          "available",
          "enquire",
          "sold"
        ],
        "label": "Status"
      }
    },
    "cta_link": {
      "type": "Link",
      "config": {
        "allowTargetBlank": true,
        "label": "Custom Button Link"
      }
