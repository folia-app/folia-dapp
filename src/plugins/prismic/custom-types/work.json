    "cta_text": {
      "type": "Text",
      "config": {
        "label": "Custom Button Text",
        "placeholder": "JOIN | LAUNCH | ..."
      }
    },
    "enquire_button": {
      "type": "Boolean",
      "config": {
        "default_value": false,
        "label": "Enquire Button"
      }
    },
    "set": {
      "type": "Link",
      "config": {
        "select": "document",
        "customtypes": [
          "set"
        ],
        "label": "(Set/Series)",
        "placeholder": "Link a Set"
      }
    },
    "year": {
      "type": "Number",
      "config": {
        "label": "Year"
      }
    },
    "price_eth": {
      "type": "Number",
      "config": {
        "label": "Price (ETH)",
        "placeholder": "0.01"
      }
